# generated by the mh-analog-designer tool's run_sim.py -- materialized from
# sch/<block>/*.sch templates, regenerated on every run, not source. Only the
# 3 currently-wired blocks are listed explicitly (matches this project's own
# convention of one materialized <block>.sch scratch file per block, right
# next to that block's own permanent <block>.sym) -- add a line here for any
# new block wired into config.json's blocks.<name>.topologies.
sch/cmos_vref.sch
sch/output_amp.sch
sch/top.sch

# copied from the PDK's default xschemrc by the mh-analog-designer tool's run_sim.py; idempotently
# regenerated if missing
xschemrc

# simulation outputs: netlists, raw ngspice data, plots, per-variation run log,
# plus the compact sim/results.jsonl and sim/variations.jsonl logs. All
# regenerable from the mh-analog-designer tool's run_sim.py + config.json --
# not tracked, so local runs don't churn the repo with result snapshots.
sim/

# trained surrogate models (weights + config + registry): tool-generated
# data from the mh-analog-designer "pro" distribution, never part of this
# project's own source -- and deliberately never tracked here at all, even
# the small config/registry files, since this repo is public and the
# surrogate-model feature is not.
models/

# stale leftover from a previous (sky130) revision of this project
simulations/

# python
__pycache__/
*.pyc
