{
    "dir": {
        "testbench": "tb",
        "simulation": "sim"
    },
    "technology": {
        "mosfet_limits": {
            "lv": {"vgs_max": 1.65, "vds_max": 1.65, "vgb_max": 1.65, "vdb_max": 6.0, "vsb_max": 6.0},
            "hv": {"vgs_max": 3.3, "vds_max": 3.3, "vgb_max": 3.3, "vdb_max": 6.0, "vsb_max": 6.0}
        }
    },
    "defaults": {
        "vdd": "1.8",
        "ibias": "100n",
        "Cload": "1.0f",
        "Rload": "1Meg",
        "tran_start": "9n",
        "tran_step": "10p",
        "tran_stop": "15n",
        "vdiff": "-10m",
        "vcm": "1.7",
        "amp_vcm": "0.9",
        "temperature": "25",
        "corner": "tt",
        "avdd18": "1.8",
        "dvdd": "1.8",
        "ena": "0",
        "trim0": "0",
        "trim1": "0",
        "trim2": "0",
        "trim3": "1.8"
    },
    "blocks": {
        "cmos_vref": {
            "symbol": "cmos_vref.sym",
            "profiles": {
                "low_power": {
                    "description": "Notably lower current consumption than the spec requires",
                    "figure_of_merit": "pow(vref_core_current_consumption/vref_core_current_consumption_max, -2)*pow(estimated_layout_area/estimated_layout_area_max, -2)*pow(temperature_coefficient_commercial_0_70c/temperature_coefficient_commercial_0_70c_max, -1.5) * pow(line_regulation/line_regulation_max, -1.2) * pow(load_regulation/load_regulation_max, -1.5) * pow(startup_settling_time/startup_settling_time_max, -1) * pow(psrr_1khz/psrr_1khz_min, 1)",
                    "constraints": {
                        "vref_core_current_consumption": {"maximum": 0.3},
                        "estimated_layout_area": {"maximum": 6000},
                        "temperature_coefficient_commercial_0_70c": {"maximum": 200},
                        "line_regulation": {"maximum": 0.50},
                        "load_regulation": {"maximum": 0.50},
                        "startup_settling_time": {"maximum": 1000},
                        "psrr_1khz": {"minimum": 50}
                    }
                },
                "high_performance": {
                    "description": "Meets temperature coefficient, line/load regulation, startup, and PSRR specs simultaneously",
                    "figure_of_merit": "pow(vref_core_current_consumption/vref_core_current_consumption_max, -1)*pow(estimated_layout_area/estimated_layout_area_max, -1)*pow(temperature_coefficient_full_40_125c/temperature_coefficient_full_40_125c_max, -2) * pow(line_regulation/line_regulation_max, -1.2) * pow(load_regulation/load_regulation_max, -1.5) * pow(startup_settling_time/startup_settling_time_max, -1) * pow(psrr_1khz/psrr_1khz_min, 2)",
                    "constraints": {
                        "vref_core_current_consumption": {"maximum": 1.0},
                        "estimated_layout_area": {"maximum": 6000},
                        "temperature_coefficient_full_40_125c": {"maximum": 100},
                        "line_regulation": {"maximum": 0.10},
                        "load_regulation": {"maximum": 0.50},
                        "startup_settling_time": {"maximum": 50},
                        "psrr_1khz": {"minimum": 60}
                    }
                }
            },
            "topologies": {
                "default": {
                    "description": "CMOS vref generator that compensates the FET VTH CTAT behaviour with a PTAT current generated with a self biased voltage following current mirror.",
                    "references": [
                        "OLIVEIRA, Arthur Campos de. Temperature compensated subthreshold CMOS voltage references for ultra low power applications. 2017.",
                        "CAMACHO-GALEANO, Edgar Mauricio; GALUP-MONTORO, Carlos; SCHNEIDER, Márcio Cherem. A 2-nW 1.1-V self-biased current reference in CMOS technology. IEEE Transactions on Circuits and Systems II: Express Briefs, v. 52, n. 2, p. 61-65, 2005."
                    ],
                    "schematic": "cmos_vref/cmos_vref_default.sch",
                    "genparams": "sch/cmos_vref_default_genparams.py",
                    "parameters_file": "params/cmos_vref/default.json"
                },
                "lvfet": {
                    "description": "Same as default, but every core NMOS (M1/M2/M6/M7/M8/M9/M12/M13) uses low-voltage (1.2V) NMOS (sg13_lv_nmos) instead of high-voltage NMOS, to evaluate TC quality with LV devices -- M3/M10/M11 (PMOS mirror devices) stay HV. Startup cap intentionally reduced (side halved to 3.5u, mult=1) as a starting point since the LV NMOS is expected to cause startup voltage overshoot -- will need further tuning.",
                    "schematic": "cmos_vref/cmos_vref_lvfet.sch",
                    "parameters_file": "params/cmos_vref/lvfet.json"
                }
            }
        },
        "output_amp": {
            "symbol": "output_amp.sym",
            "profiles": {
                "low_power": {
                    "description": "Notably lower current consumption and area than the spec requires, while keeping gain/phase margin/PSRR/load regulation within acceptable bounds",
                    "figure_of_merit": "pow(output_amp_current_consumption/output_amp_current_consumption_max, -2) * pow(estimated_layout_area/estimated_layout_area_max, -2) * pow(open_loop_dc_gain/open_loop_dc_gain_min, 1) * pow(phase_margin/phase_margin_min, 1) * pow(psrr_1khz/psrr_1khz_min, 1) * pow(load_regulation/load_regulation_max, -1.5)",
                    "constraints": {
                        "output_amp_current_consumption": {"maximum": 5.0},
                        "estimated_layout_area": {"maximum": 2000},
                        "open_loop_dc_gain": {"minimum": 35},
                        "phase_margin": {"minimum": 45},
                        "psrr_1khz": {"minimum": 50},
                        "load_regulation": {"maximum": 100}
                    }
                }
            },
            "topologies": {
                "default": {
                    "description": "Two-stage Miller-compensated CMOS op-amp: NMOS differential pair with cascode stack and active PMOS mirror load, common-source PMOS output driver. Used as a unity-feedback DC buffer for cmos_vref.",
                    "schematic": "output_amp/output_amp_def.sch",
                    "parameters_file": "params/output_amp/default.json"
                }
            }
        },
        "top": {
            "symbol": "top.sym",
            "profiles": {
                "low_power": {
                    "description": "Notably lower current consumption (enabled and standby) than the Chipalooza #2 target spec requires, while still meeting the area/TC/PSRR targets (ihp_mh_ip__cmos_vref_proposal.pdf, Table 2)",
                    "figure_of_merit": "pow(top_current_consumption/top_current_consumption_max, -2) * pow(standby_current_disabled/standby_current_disabled_max, -2) * pow(estimated_layout_area/estimated_layout_area_max, -1) * pow(temperature_coefficient_industrial_40_85c/temperature_coefficient_industrial_40_85c_max, -1) * pow(psrr_1khz/psrr_1khz_min, 1)",
                    "constraints": {
                        "top_current_consumption": {"maximum": 2.2},
                        "standby_current_disabled": {"maximum": 5000},
                        "estimated_layout_area": {"maximum": 50000},
                        "temperature_coefficient_industrial_40_85c": {"maximum": 80},
                        "psrr_1khz": {"minimum": 50}
                    }
                }
            },
            "topologies": {
                "default": {
                    "description": "Vref core + output buffer amp integration: cmos_vref (X1) generates vref/pbias/vbg*, output_amp (x2) buffers it, plus a PMOS bias mirror (M1, sized off cmos_vref's own M3), an enable switch (M2), and trim resistors/switches (R1-R8/M6-M9).",
                    "schematic": "top/top_default.sch",
                    "parameters_file": "params/top/default.json",
                    "sub_blocks": {
                        "X1": {"block": "cmos_vref", "topology": "default"},
                        "x2": {"block": "output_amp", "topology": "default"}
                    }
                }
            }
        }
    },
    "tests": {
        "cmos_vref": {
            "area": {
                "simulator": "netlist",
                "testbench": "tb/cmos_vref/tb_vref_power.sch",
