{
    "dir": {
        "testbench": "tb",
        "simulation": "sim"
    },
    "defaults": {
        "vdd": "1.8",
        "ibias": "100n",
        "Cload": "1.0f",
        "Rload": "1Meg",
        "tran_start": "9n",
        "tran_step": "10p",
        "tran_stop": "15n",
        "vdiff": "-10m",
        "vcm": "1.7",
        "amp_vcm": "0.9",
        "temperature": "25",
        "corner": "tt"
    },
    "blocks": {
        "cmos_vref": {
            "symbol": "cmos_vref.sym",
            "profiles": {
                "low_power": {
                    "description": "Notably lower current consumption than the spec requires",
                    "figure_of_merit": "pow(vref_core_current_consumption/vref_core_current_consumption_max, -2)*pow(estimated_layout_area/estimated_layout_area_max, -2)*pow(temperature_coefficient_commercial_0_70c/temperature_coefficient_commercial_0_70c_max, -1.5) * pow(line_regulation/line_regulation_max, -1.2) * pow(load_regulation/load_regulation_max, -1.5) * pow(startup_settling_time/startup_settling_time_max, -1) * pow(psrr_1khz/psrr_1khz_min, 1)",
                    "constraints": {
                        "vref_core_current_consumption": {"maximum": 0.3},
                        "estimated_layout_area": {"maximum": 6000},
                        "temperature_coefficient_commercial_0_70c": {"maximum": 200},
                        "line_regulation": {"maximum": 0.50},
                        "load_regulation": {"maximum": 0.50},
                        "startup_settling_time": {"maximum": 1000},
                        "psrr_1khz": {"minimum": 50}
                    }
                },
                "high_performance": {
                    "description": "Meets temperature coefficient, line/load regulation, startup, and PSRR specs simultaneously",
                    "figure_of_merit": "pow(vref_core_current_consumption/vref_core_current_consumption_max, -1)*pow(estimated_layout_area/estimated_layout_area_max, -1)*pow(temperature_coefficient_full_40_125c/temperature_coefficient_full_40_125c_max, -2) * pow(line_regulation/line_regulation_max, -1.2) * pow(load_regulation/load_regulation_max, -1.5) * pow(startup_settling_time/startup_settling_time_max, -1) * pow(psrr_1khz/psrr_1khz_min, 2)",
                    "constraints": {
                        "vref_core_current_consumption": {"maximum": 1.0},
                        "estimated_layout_area": {"maximum": 6000},
                        "temperature_coefficient_full_40_125c": {"maximum": 100},
                        "line_regulation": {"maximum": 0.10},
                        "load_regulation": {"maximum": 0.50},
                        "startup_settling_time": {"maximum": 50},
                        "psrr_1khz": {"minimum": 60}
                    }
                }
            },
            "topologies": {
                "default": {
                    "description": "CMOS vref generator that compensates the FET VTH CTAT behaviour with a PTAT current generated with a self biased voltage following current mirror.",
                    "references": [
                        "OLIVEIRA, Arthur Campos de. Temperature compensated subthreshold CMOS voltage references for ultra low power applications. 2017.",
                        "CAMACHO-GALEANO, Edgar Mauricio; GALUP-MONTORO, Carlos; SCHNEIDER, Márcio Cherem. A 2-nW 1.1-V self-biased current reference in CMOS technology. IEEE Transactions on Circuits and Systems II: Express Briefs, v. 52, n. 2, p. 61-65, 2005."
                    ],
                    "schematic": "cmos_vref/cmos_vref_default.sch",
                    "genparams": "sch/cmos_vref_default_genparams.py",
                    "parameters_file": "params/cmos_vref/default.json"
                }
            }
        },
        "output_amp": {
            "symbol": "output_amp.sym",
            "topologies": {
                "default": {
                    "description": "Two-stage Miller-compensated CMOS op-amp: NMOS differential pair with cascode stack and active PMOS mirror load, common-source PMOS output driver. Used as a unity-feedback DC buffer for cmos_vref.",
                    "schematic": "output_amp/output_amp_def.sch",
                    "parameters": [
                        "nbias_length",
                        "m1_width",
                        "m2_width",
                        "m3_width",
                        "m4m5_length",
                        "m4m5_width",
                        "m6m7_length",
                        "m6m7_width",
                        "m8m9_length",
                        "m8m9_width",
                        "m10_length",
                        "m10_width",
                        "millercap_side",
                        "millercap_mult"
                    ],
                    "parameter_sets": {
                        "nominal": [
                            "1u",
                            "2.5u",
                            "5u",
                            "8u",
                            "2u",
                            "10u",
                            "2u",
                            "20u",
                            "10u",
                            "5u",
                            "5u",
                            "40u",
                            "5u",
                            "1"
                        ]
                    },
                    "parameters_file": "params/output_amp/default.json"
                }
            }
        }
    },
    "variants": [
        {
            "description": "Default",
            "topology": {
                "ampop": "default",
                "diff_diff_amp": "default",
                "clk_comp": "default",
                "dac": "default"
            },
            "parameter_set": {
                "ampop": "nominal",
                "diff_diff_amp": "nominal",
                "clk_comp": "nominal",
                "dac": "nominal"
            }
        }
    ],
    "tests": {
        "cmos_vref": {
            "area": {
                "simulator": "netlist",
                "testbench": "tb/cmos_vref/tb_vref_power.sch",
                "parser": "tb/cmos_vref/tb_vref_area.py",
                "outputs": [
                    {
                        "description": "Estimated layout area",
                        "unit": "µm²"
                    }
                ]
            },
            "current_consumption": {
                "simulator": "ngspice",
                "testbench": "tb/cmos_vref/tb_vref_power.sch",
                "parser": "tb/cmos_vref/tb_vref_power.py",
                "outputs": [
                    {
                        "description": "Vref core current consumption",
                        "unit": "uA"
                    }
                ],
                "conditions": {
                    "vdd": [
                        "1.8"
                    ],
                    "Cload": [
                        "1.0f"
                    ],
                    "Rload": [
                        "1Meg"
                    ],
                    "temperature": [
                        "-40",
                        "25",
                        "125"
                    ],
                    "corner": [
                        "tt",
                        "ss",
                        "ff"
                    ]
                }
            },
            "temp_sweep": {
                "simulator": "ngspice",
                "testbench": "tb/cmos_vref/tb_vref_temp_sweep.sch",
                "parser": "tb/cmos_vref/tb_vref_temp_sweep.py",
                "outputs": [
                    {
                        "description": "Vref output voltage",
                        "unit": "V"
                    },
                    {
                        "description": "Temperature coefficient (commercial 0-70C)",
                        "unit": "ppm/°C",
                        "range": [0, 70]
                    },
                    {
                        "description": "Temperature coefficient (industrial -40-85C)",
                        "unit": "ppm/°C",
                        "range": [-40, 85]
                    },
                    {
                        "description": "Temperature coefficient (full -40-125C)",
                        "unit": "ppm/°C",
                        "range": [-40, 125]
                    }
                ],
                "conditions": {
                    "vdd": [
                        "1.8"
                    ],
                    "Cload": [
                        "1.0f"
                    ],
                    "Rload": [
                        "1Meg"
                    ],
                    "temperature": [
                        "-40",
                        "-20",
                        "0",
                        "25",
                        "50",
                        "75",
                        "100",
                        "125"
                    ],
                    "corner": [
                        "tt",
                        "ss",
                        "ff"
                    ]
                }
            },
            "line_reg": {
                "simulator": "ngspice",
                "testbench": "tb/cmos_vref/tb_vref_line_reg.sch",
                "parser": "tb/cmos_vref/tb_vref_line_reg.py",
                "outputs": [
                    {
                        "description": "Line regulation",
                        "unit": "%",
                        "scale": "log"
                    }
                ],
                "conditions": {
                    "vdd": [
                        "1.62",
                        "1.98"
                    ],
                    "Cload": [
                        "1.0f"
                    ],
                    "temperature": [
                        "-40",
                        "25",
                        "125"
                    ],
                    "corner": [
                        "tt",
                        "ss",
                        "ff"
                    ]
                }
            },
            "load_reg": {
                "simulator": "ngspice",
                "testbench": "tb/cmos_vref/tb_vref_load_reg.sch",
                "parser": "tb/cmos_vref/tb_vref_load_reg.py",
                "outputs": [
                    {
                        "description": "Load regulation",
                        "unit": "%",
                        "scale": "log"
                    }
                ],
                "conditions": {
                    "vdd": [
                        "1.8"
                    ],
                    "Cload": [
                        "1.0f"
                    ],
                    "iload": [
                        "0",
                        "2e-8"
                    ],
                    "temperature": [
                        "-40",
                        "25",
                        "125"
                    ],
                    "corner": [
                        "tt",
                        "ss",
                        "ff"
                    ]
                }
            },
            "startup": {
                "simulator": "ngspice",
                "testbench": "tb/cmos_vref/tb_vref_startup.sch",
                "parser": "tb/cmos_vref/tb_vref_startup.py",
                "outputs": [
                    {
                        "description": "Startup settling time",
                        "unit": "us"
                    }
                ],
                "conditions": {
                    "vdd": [
                        "1.8"
                    ],
                    "Cload": [
                        "1.0f"
                    ],
                    "temperature": [
                        "25"
                    ],
                    "corner": [
                        "tt",
                        "ss",
                        "ff"
                    ]
                }
            },
            "psrr": {
                "simulator": "ngspice",
                "testbench": "tb/cmos_vref/tb_vref_psrr.sch",
                "parser": "tb/cmos_vref/tb_vref_psrr.py",
                "outputs": [
                    {
                        "description": "PSRR @ 1kHz",
                        "unit": "dB"
                    }
                ],
                "conditions": {
                    "vdd": [
                        "1.8"
                    ],
                    "Cload": [
                        "1.0f"
                    ],
                    "frequency": [
                        "1k"
                    ],
                    "temperature": [
                        "25"
                    ],
                    "corner": [
                        "tt",
                        "ss",
                        "ff"
                    ]
                }
            }
        },
        "output_amp": {
            "current_consumption": {
                "simulator": "ngspice",
                "testbench": "tb/output_amp/tb_amp_power.sch",
                "parser": "tb/output_amp/tb_amp_power.py",
                "outputs": [
                    {
                        "description": "Output amp current consumption",
                        "unit": "uA"
                    }
                ],
                "conditions": {
                    "vdd": ["1.8"],
                    "Cload": ["1.0f"],
                    "temperature": ["-40", "25", "125"],
                    "corner": ["tt", "ss", "ff"]
                }
            },
            "area": {
                "simulator": "netlist",
                "testbench": "tb/output_amp/tb_amp_power.sch",
                "parser": "tb/output_amp/tb_amp_area.py",
                "outputs": [
                    {
                        "description": "Estimated layout area",
                        "unit": "µm²"
                    }
                ]
            },
            "openloop_ac": {
                "simulator": "ngspice",
                "testbench": "tb/output_amp/tb_amp_openloop_ac.sch",
                "parser": "tb/output_amp/tb_amp_openloop_ac.py",
                "outputs": [
                    {
                        "description": "Open-loop DC gain",
                        "unit": "dB"
                    },
                    {
                        "description": "Unity-gain bandwidth",
                        "unit": "MHz"
                    },
                    {
                        "description": "Phase margin",
                        "unit": "deg",
                        "minimum": 45
                    }
                ],
                "conditions": {
                    "vdd": ["1.8"],
                    "Cload": ["1.0f"],
                    "temperature": ["-40", "25", "125"],
                    "corner": ["tt", "ss", "ff"]
                }
            },
            "psrr": {
                "simulator": "ngspice",
                "testbench": "tb/output_amp/tb_amp_psrr.sch",
                "parser": "tb/output_amp/tb_amp_psrr.py",
                "outputs": [
                    {
                        "description": "PSRR (10Hz-10MHz, worst case)",
                        "unit": "dB",
                        "minimum": 50
                    }
                ],
                "conditions": {
                    "vdd": ["1.8"],
                    "Cload": ["1.0f"],
                    "temperature": ["25"],
                    "corner": ["tt", "ss", "ff"]
                }
            },
            "load_reg": {
                "simulator": "ngspice",
                "testbench": "tb/output_amp/tb_amp_load_reg.sch",
                "parser": "tb/output_amp/tb_amp_load_reg.py",
                "outputs": [
                    {
                        "description": "Load regulation",
                        "unit": "%",
                        "scale": "log"
                    }
                ],
                "conditions": {
                    "vdd": ["1.8"],
                    "Cload": ["1.0f"],
                    "iload": ["-1e-6", "1e-6"],
                    "temperature": ["-40", "25", "125"],
                    "corner": ["tt", "ss", "ff"]
                }
            }
        },
        "top": {
            "snr": {
                "testbench": "tb_sigma_delta_snr.sch",
                "parser": "sigma_delta_snr.py",
                "outputs": [
                    {
                        "description": "Signal-to-Noise Ratio",
                        "unit": "dB",
                        "minimum": 60
                    }
                ],
                "conditions": {
                    "vcm": [
                        "0.9"
                    ],
                    "corner": [
                        "tt"
                    ]
                }
            }
        }
    }
}
